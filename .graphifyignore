#-------------------------
# Dependensi & Build
#-------------------------
vendor/
node_modules/
build/
builds/
dist/

#-------------------------
# Output Graphify Sendiri
#-------------------------
graphify-out/

#-------------------------
# Writable / Runtime CI4
#-------------------------
writable/
fotowm/

