public/assets/
public/uploads/
*.jpg
*.jpeg
*.png
*.gif
*.svg
*.ico
*.webp
*.pdf
*.zip
*.tar.gz

#-------------------------
# File Konfigurasi IDE & OS
#-------------------------
.idea/
.vscode/
nbproject/
.DS_Store
Thumbs.db
*~

#-------------------------
# Docker & Dokumentasi
#-------------------------
docker/
docs/
user_guide_src/

