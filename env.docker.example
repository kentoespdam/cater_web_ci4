#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:84/'
app.forceGlobalSecureRequests = false
app.fotoWmPath = '/var/www/html/fotowm/'

#--------------------------------------------------------------------
# EXTERNAL DATABASE SETTINGS (DOCKER)
#--------------------------------------------------------------------
database.default.hostname = host.docker.internal
database.default.database = cater_web_ci4
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Database Connection Group 2: sikompak (used by CabangModel, CustModel, etc.)
database.sikompak.hostname = host.docker.internal
database.sikompak.database = sikompak
database.sikompak.username = root
database.sikompak.password = 
database.sikompak.DBDriver = MySQLi
database.sikompak.DBPrefix =
database.sikompak.port = 3306

#--------------------------------------------------------------------
# DOCKER COMPOSE CONFIGURATION
#--------------------------------------------------------------------
APP_PORT=84
FOTOWM_PATH=/path/to/mount
UID=1000
GID=1000
